{
  "name": "cctv-tool-suite",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run dev -w @cctv/web",
    "build": "npm run build --workspaces --if-present",
    "format": "oxfmt -c oxfmt.config.mjs --write .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "oxlint -c oxlint.config.mjs .",
    "lint:css": "stylelint \"**/*.css\" --cache",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "oxc-config-mantine": "1.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "7.0.2"
  }
}
